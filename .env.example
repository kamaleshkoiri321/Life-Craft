# -----------------------------------------------------------------------------
# LifeCraft Environment Variables (Template / Example)
# Copy this file to `.env.local` and provide your production secrets.
# NEVER commit `.env.local` to version control.
# -----------------------------------------------------------------------------

# Application Base URL
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Authentication (Clerk Core 3)
# -----------------------------------------------------------------------------
# Public Clerk Publishable Key (from Clerk Dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Server-Only Clerk Secret Key (Never expose to client)
CLERK_SECRET_KEY="sk_test_..."

# Clerk Webhook Signing Secret (from Clerk Dashboard -> Webhooks -> Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Standard Clerk URL Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/app"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/app"

# -----------------------------------------------------------------------------
# Database (Neon Serverless PostgreSQL)
# -----------------------------------------------------------------------------
# Server-only connection string (Neon Console -> Connect -> Connection string)
DATABASE_URL="postgresql://<user>:<password>@<neon-endpoint>.neon.tech/lifecraftdb?sslmode=require"

# -----------------------------------------------------------------------------
# Object Storage (Neon / S3-Compatible Storage for Library Uploads)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID="your-storage-access-key-id"
AWS_SECRET_ACCESS_KEY="your-storage-secret-access-key"
AWS_ENDPOINT_URL_S3="https://<your-storage-endpoint>.neon.tech"
AWS_REGION="us-east-2"
NEON_STORAGE_BUCKET="lifecraft-uploads"

# -----------------------------------------------------------------------------
# Optional AI Assistant Integration
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# -----------------------------------------------------------------------------
# Email Notification System (Gmail SMTP + Nodemailer)
# -----------------------------------------------------------------------------
# SMTP server host and port (Gmail SMTP uses STARTTLS on port 587)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587

# Your personal or production Gmail address (displayed as the sender address)
SMTP_USER="your-email@gmail.com"

# 16-character Google App Password (generate at https://myaccount.google.com/apppasswords)
SMTP_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Sender display name appearing in recipients' inboxes
EMAIL_FROM_NAME="LifeCraft"

# Secret token securing the background reminder dispatch endpoint (/api/cron/reminders)
CRON_SECRET="your-secure-cron-secret-token"

# Testing Mode Configuration:
# When true, all notifications are redirected safely to EMAIL_TEST_RECIPIENT
EMAIL_TEST_MODE="true"
EMAIL_TEST_RECIPIENT="your-email@gmail.com"

